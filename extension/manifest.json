{
  "manifest_version": 3,
  "name": "YoDips",
  "version": "0.3.5",
  "description": "YoDips SSO Undip browser extension untuk mahasiswa Universitas Diponegoro. Integrasi login Kulon, SIAP, IRS, KHS tanpa kredensial.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://backend.crunchy.my.id/*",
    "https://sso.crunchy.my.id/*",
    "*://*.undip.ac.id/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "https://sso.crunchy.my.id/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://sso.crunchy.my.id/*"
      ],
      "js": [
        "dist/content-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "YoDips"
  }
}
