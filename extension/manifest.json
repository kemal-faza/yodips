{
  "manifest_version": 3,
  "name": "Undip SSO Login",
  "version": "0.2.0",
  "description": "Login SSO Undip via browser tanpa kredensial: baca cookie Kazan SSO/Kulon/SIAP dan hubungkan ke dashboard.",
  "permissions": ["cookies", "storage", "tabs", "alarms"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "*://*.undip.ac.id/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"]
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["dist/content-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "Undip SSO Login"
  }
}
