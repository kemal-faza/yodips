{
  "name": "yodips-extension",
  "private": true,
  "type": "module",
  "version": "0.3.2",
  "scripts": {
    "release": "node scripts/release.mjs",
    "build": "vite build && node scripts/pack-popup.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "edge:dev": "node scripts/launch-edge.mjs",
    "chrome:dev": "node scripts/launch-chrome.mjs",
    "watch:reload": "node scripts/watch-reload.mjs",
    "dev:ext": "npm run build && npm run chrome:dev && npm run watch:reload"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
