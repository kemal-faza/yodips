NODE_ENV=development
SSO_BASE_URL=https://sso.undip.ac.id
SSO_LOGIN_PATH=/sso/auth_v2
# Generate a strong secret: `openssl rand -hex 32`
JWT_SECRET=change-me-in-production-32chars-min
JWT_EXPIRES_IN=12h
PORT=3000

# CORS origins (comma-separated) for the frontend
CORS_ORIGIN=http://localhost:5173

# Microsoft Entra (for Kulon OIDC)
MS_TENANT_ID=03290435-ff74-45d1-aeaa-173677221cf8
MS_CLIENT_ID=d4e33023-d86d-4234-8a41-cd60a2145e36
MS_CLIENT_SECRET=change-me
MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Playwright (browser automation for SSO session capture)
CDP_URL=http://127.0.0.1:9223
SSO_DASHBOARD_URL=https://sso.undip.ac.id/pages/dashboard

# Interactive login (headed browser) — Playwright opens a visible browser window
# for the user to log in to SSO, then captures the session.
SSO_LOGIN_URL=https://sso.undip.ac.id/auth/user/login
CHROME_PROFILE_DIR=/tmp/sso-chrome-profile
# Browser binary for the interactive login window. Defaults to Google Chrome;
# set to your default browser if you prefer, e.g. Edge:
# CHROME_PATH=/usr/bin/microsoft-edge
# Note: the window always runs in an isolated fresh profile (CHROME_PROFILE_DIR),
# never your default profile with its stored sessions.

# Interactive capture: how long to wait for a valid Kulon session (ms)
SSO_CAPTURE_TIMEOUT_MS=180000

# Session store: memory (dev/test, no Redis) | redis (production)
SESSION_BACKEND=memory

# CACHE_TTL_MS=60000   # per-user data cache TTL for Kulon/SIAP dashboard data

# SIAP official API (app resmi SIAP) — data akademik via JSON, bukan scrape HTML.
# SIAP_API_BASE=https://api.siap.undip.ac.id/index.php
# SIAP_APP_VER=24

# Pairing perangkat (opsional): origin frontend untuk QR URL + umur kode.
# FRONTEND_BASE_URL=https://sso.crunchy.my.id
# PAIRING_TTL_MS=300000

# --- production only ---
# REDIS_URL=redis://:password@127.0.0.1:6379
# SESSION_ENC_KEY=<openssl rand -hex 32>
# SESSION_TTL_MS=604800000
# SESSION_ABSOLUTE_TTL_MS=604800000  # optional; default = SESSION_TTL_MS. Set
#                                    # shorter (e.g. 86400000 = 24h) to bound how
#                                    # long silent refresh can extend a session.

# --- Web Push (VAPID) ---
# WEB_PUSH_ENABLED=true
# WEB_PUSH_VAPID_PUBLIC_KEY=<url-safe base64, generate via web-push>
# WEB_PUSH_VAPID_PRIVATE_KEY=<url-safe base64>
# WEB_PUSH_SUBJECT=mailto:admin@yodips.dev
# WEB_PUSH_MAX_SUBSCRIPTIONS=8   # per-user cap (atomic, Lua/InMemory)
# WEB_PUSH_CYCLE_BUDGET=50       # GLOBAL web sends per poller cycle (all users/events)