# ============================================================
# env.production.example — TEMPLATE env untuk produksi.
# Berisi placeholder SAJA (tidak ada nilai/sensitif). Salin menjadi
# `.env` (VPS) atau set manual sebagai Heroku config vars (JANGAN commit).
# Isi tiap REPLACE_* sebelum deploy; kelengkapan divalidasi backend via
# env.validation.ts (@IsNotEmpty) — kosong = proses tidak boot.
# ============================================================

NODE_ENV=production
PORT=REPLACE_PORT_OR_OMIT

# ---- SSO / dashboard — salin _nilai_working_ dari backend/.env lokal
SSO_BASE_URL=REPLACE_SSO_BASE_URL
SSO_LOGIN_URL=REPLACE_SSO_LOGIN_URL
SSO_DASHBOARD_URL=REPLACE_SSO_DASHBOARD_URL

# ---- JWT — WAJIB random 64 hex (openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_64HEX_RANDOM
JWT_EXPIRES_IN=REPLACE_JWT_EXPIRES_IN

# ---- Microsoft Entra — BOLEH DUMMY NON-EMPTY.
#      Login real = extension/mobile cookie-capture → handoff (TIDAK pakai OAuth).
#      Jalur /api/auth/microsoft/* deprecated & tak cukup untuk data (C1b).
#      Empat nilai ini cuma untuk lolos @IsNotEmpty() saat boot — isi dummy aja.
MS_TENANT_ID=REPLACE_MS_TENANT_ID_OR_DUMMY
MS_CLIENT_ID=REPLACE_MS_CLIENT_ID_OR_DUMMY
MS_CLIENT_SECRET=REPLACE_MS_CLIENT_SECRET_OR_DUMMY
# Dipakai hanya kalau route OAuth di-hits; tidak perlu terdaftar di Entra.
MS_REDIRECT_URI=REPLACE_MS_REDIRECT_URI_OR_DUMMY

# ---- Jalur capture deprecated — dummy loopback (port tanpa listener) supaya nonaktif
CDP_URL=REPLACE_CDP_URL_OR_LOOPBACK_DUMMY
CHROME_PROFILE_DIR=REPLACE_CHROME_PROFILE_DIR_OR_DUMMY
SSO_CAPTURE_TIMEOUT_MS=REPLACE_SSO_CAPTURE_TIMEOUT_MS

# ---- Session store — WAJIB redis di prod (in-memory hilang tiap restart)
SESSION_BACKEND=redis
REDIS_URL=REPLACE_REDIS_URL
# WAJIB random saat redis (module THROW kalau kosong). Generate: openssl rand -hex 32
SESSION_ENC_KEY=REPLACE_WITH_64HEX_RANDOM
SESSION_TTL_MS=REPLACE_SESSION_TTL_MS
CACHE_TTL_MS=REPLACE_CACHE_TTL_MS

# ---- CORS — isi origin frontend bila web & API beda origin (comma-separated).
#      Same-origin (Caddy) → boleh dikosongkan.
# CORS_ORIGIN=REPLACE_CORS_ORIGIN

# ---- Proxy / throttling (YD-RATE-001) -------------------------------------
# Express `trust proxy` hop count (ANGKA, jangan pernah true).
# FAIL-SAFE: kalau tidak di-set, default 0 → X-Forwarded-For TIDAK dipercaya
# (tracker = socket IP). WAJIB set eksplisit sesuai JUMLAH proxy tepercaya:
#   Heroku prod (backend.crunchy.my.id): 2 — Cloudflare + Heroku router
#     (verified 2026-09-04: DNS→CF, server: cloudflare, router fwd=[client, cf-edge])
#   VPS Caddy same-origin (satu proxy): 1
#   0 = direct/no proxy (dev)
TRUST_PROXY_HOPS=2
