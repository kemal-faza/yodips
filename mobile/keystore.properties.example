# Salin file ini menjadi `keystore.properties` (JANGAN commit ke git).
# Dipakai untuk menandatangani APK release supaya update di Android bisa naik
# versi dari APK yang sudah terpasang (key harus konsisten).
#
# `storeFile` relatif terhadap root Gradle = mobile/ (lihat build.gradle.kts).
# Tanpa file ini, `assembleRelease` tetap jalan tapi APK TIDAK di-sign.
#
# Untuk CI: nilai-nilai ini disuplai dari GitHub Secrets (lihat
# .github/workflows/release.yml) — jangan commit di sini.
storeFile=keystore/undip-sso.jks
storePassword=GANTI_RAHASIA
keyAlias=undip-sso
keyPassword=GANTI_RAHASIA
