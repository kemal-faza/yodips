<?xml version="1.0" encoding="utf-8"?>
<!-- Dev config: allow cleartext HTTP to the local backend (http://10.0.2.2:3000
     from the emulator) and siap/kulon/sso hosts. Production must use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- 10.0.2.2 = host loopback as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="true">siap.undip.ac.id</domain>
        <domain includeSubdomains="true">sso.undip.ac.id</domain>
        <domain includeSubdomains="true">kulon2.undip.ac.id</domain>
    </domain-config>
</network-security-config>
